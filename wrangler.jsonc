{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "subshare",
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-09-26",
  // Production is served only from the custom domain; wrangler creates its DNS record.
  "routes": [{ "pattern": "subshare.dev1sme.cloud", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // No "directory": @cloudflare/vite-plugin points assets at the client build output.
    "not_found_handling": "single-page-application",
    // Only these paths reach the Worker; anything else is served index.html with 200.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subshare-db",
      "database_id": "0ccc6fd7-6ca5-4661-9a08-22adcb31b6ab",
      "migrations_dir": "./migrations"
    }
  ],
  "secrets": { "required": ["JWT_SECRET"] },
  "observability": { "enabled": true }
}
